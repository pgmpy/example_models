network unknown {
}
variable Depth {
  type discrete [ 2 ] { 0-20, 20-40 };
}
variable EC {
  type discrete [ 2 ] { Less than 1.4, More than 1.4 };
}
variable Intensity {
  type discrete [ 2 ] { Less than 0.3, More than 0.3 };
}
variable Length {
  type discrete [ 2 ] { Less than 20, More than 20 };
}
variable pH {
  type discrete [ 2 ] { Less than 7.7, More than 7.7 };
}
variable W {
  type discrete [ 2 ] { Less than 10, More than 10 };
}
probability ( Depth ) {
  table 0.5, 0.5;
}
probability ( EC | Depth, Intensity ) {
  (0-20, Less than 0.3) 0.0, 1.0;
  (20-40, Less than 0.3) 1.0, 0.0;
  (0-20, More than 0.3) 1.0, 0.0;
  (20-40, More than 0.3) 1.0, 0.0;
}
probability ( Intensity | pH ) {
  (Less than 7.7) 0.647, 0.353;
  (More than 7.7) 0.307, 0.693;
}
probability ( Length | EC ) {
  (Less than 1.4) 0.5, 0.5;
  (More than 1.4) 1.0, 0.0;
}
probability ( pH | Depth ) {
  (0-20) 0.133, 0.867;
  (20-40) 1.0, 0.0;
}
probability ( W | EC ) {
  (Less than 1.4) 0.05, 0.95;
  (More than 1.4) 0.5, 0.5;
}
